# Copy to .env and fill in real values. Do NOT commit your .env.

# Database
POSTGRES_USER=finance_user
POSTGRES_PASSWORD=finance_pass
POSTGRES_DB=finance_db

# API Security
# Generate with: openssl rand -hex 32
# Required to be a strong (non-placeholder) value in live mode.
SECRET_KEY=replace-me-with-openssl-rand-hex-32
# Server Fernet key. It wraps each signed-in user's data key inside their
# session token (the data itself is encrypted under that per-user key, which
# only the user's password or recovery code unlocks) and protects a few
# server-side values. Losing or changing it signs everyone out.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=replace-me-with-a-fernet-key

# TrueLayer Open Banking (get from https://console.truelayer.com/)
TRUELAYER_CLIENT_ID=
TRUELAYER_CLIENT_SECRET=
TRUELAYER_REDIRECT_URI=http://localhost:8000/api/v1/banking/callback
# true = TrueLayer sandbox; false = live banking data
TRUELAYER_SANDBOX=true

# Environment
ENVIRONMENT=development

# Production only (docker-compose.prod.yml reads these from .env.production;
# see DEPLOY.md). There the app's public URL, FRONTEND_URL, is built from
# DOMAIN. In development the defaults apply: http://localhost:5173, and with
# SMTP_HOST empty a password-reset link is logged instead of sent (never in
# live mode).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=
