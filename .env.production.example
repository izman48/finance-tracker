# Copy to .env.production ON THE SERVER and fill in. Never commit the real file.

# Public hostname (DNS A record must point at the server; Caddy gets HTTPS certs automatically)
DOMAIN=finance.example.com

# Database — pick a strong password, it is not exposed outside Docker
POSTGRES_USER=finance_user
POSTGRES_PASSWORD=
POSTGRES_DB=finance_db

# Generate with: openssl rand -hex 32
SECRET_KEY=
# Generate with: docker run --rm python:3.12-slim python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=

# TrueLayer (https://console.truelayer.com/)
# Register https://<DOMAIN>/api/v1/banking/callback as a redirect URI in the console.
TRUELAYER_CLIENT_ID=
TRUELAYER_CLIENT_SECRET=
TRUELAYER_SANDBOX=true

# SMTP — required in production for password-reset emails. Without it, reset
# links are never delivered (and the reset flow is silently broken).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Optional but strongly recommended before inviting anyone: the contact address
# shown on the in-app privacy/terms pages. Unset, those pages tell testers to
# contact whoever invited them.
VITE_BETA_CONTACT_EMAIL=

# Optional: host folder of extra static sites Caddy also serves (see DEPLOY.md
# "Extra static sites"). Defaults to ~/sites. Keep it outside this repo folder:
# every deploy's rsync --delete removes anything here that isn't in git.
# SITES_DIR=

# Optional: put Caddy on one extra Docker network shared with another app on
# this server, so a site file in SITES_DIR can reverse_proxy to it (DEPLOY.md
# "Shared apps network"). Set all three or none; unset, nothing changes. The
# subnet must not overlap any Docker network or host route, and Caddy's
# address must sit in its lower half (Docker hands out the upper half).
# APPS_EDGE_NETWORK=apps_edge
# APPS_EDGE_SUBNET=172.31.250.0/24
# APPS_EDGE_CADDY_IP=172.31.250.10
