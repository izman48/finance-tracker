# Shared hardening for the optional extra static sites (see DEPLOY.md "Extra
# static sites"). A site file uses it as `import static_site <name>`, which
# serves /sites/<name>/ from the sites folder mounted into this container.
(static_site) {
	root * /sites/{args[0]}
	encode zstd gzip
	file_server {
		hide .*
	}

	# Pages revalidate on every load so edits show up at once; other files
	# (no content hash in their names) may be cached for a day. Only files that
	# exist: a 404 for an asset not uploaded yet must not be cached.
	@page path / *.html */
	@asset {
		not path / *.html */
		file
	}
	header @page Cache-Control "no-cache"
	header @asset Cache-Control "public, max-age=86400"

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
		# Kept out of search engines unless the site file overrides this
		# after the import, e.g. header X-Robots-Tag "all".
		X-Robots-Tag "noindex, nofollow"
	}
}

{$DOMAIN} {
	encode gzip

	# API and TrueLayer OAuth callback
	handle /api/* {
		reverse_proxy api:8000
	}

	# Remote MCP server, and its OAuth protected-resource metadata (RFC 9728)
	# that tells clients where to sign in.
	handle /mcp {
		reverse_proxy mcp:8001
	}
	handle /.well-known/oauth-protected-resource/mcp {
		reverse_proxy mcp:8001
	}
	# ...and the API is the authorization server that page points at (RFC 8414).
	# The consent page itself (/oauth/authorize) is an SPA route, served below.
	handle /.well-known/oauth-authorization-server {
		reverse_proxy api:8000
	}

	# Vite writes a content hash into every asset filename, so a given URL's
	# bytes never change — cache them hard.
	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# React SPA — serve static build, fall back to index.html for client routes.
	# index.html must be revalidated on every load: it names the hashed bundles,
	# so a cached copy pins the browser to the previous build and deploys stay
	# invisible until the browser happens to revalidate on its own. Without an
	# explicit Cache-Control browsers fall back to heuristic freshness, which is
	# exactly that failure. "no-cache" still allows a 304 via ETag, so this
	# revalidates rather than re-downloads.
	handle {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}

# Optional extra static sites: one <name>.caddy file per site in the host
# folder mounted at /sites (docker-compose.prod.yml). An empty or missing
# folder matches nothing, which Caddy treats as a warning, not an error.
import /sites/*.caddy
